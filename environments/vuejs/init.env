# Vue.js environment. These pins reproduce the versions this type resolved to before service
# versions had to be declared explicitly, so existing projects keep the images they already ran.
ROLL_DB=1
ROLL_REDIS=1

PHP_VERSION=8.1
NODE_VERSION=18
COMPOSER_VERSION=2

NGINX_VERSION=1.27
DB_DISTRIBUTION=mariadb
DB_DISTRIBUTION_VERSION=10.4
REDIS_VERSION=7.0

# The local environment type ships no compose fragment of its own - bring your own
# .roll/roll-env.yml. These pins reproduce the versions this type resolved to before service
# versions had to be declared explicitly; drop a service's toggle to 0 if you do not want it.
ROLL_NGINX=1
ROLL_DB=1
ROLL_REDIS=1

NGINX_VERSION=1.27
DB_DISTRIBUTION=mariadb
DB_DISTRIBUTION_VERSION=10.4
REDIS_VERSION=7.0

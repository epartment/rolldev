# ShellCheck configuration for this repository.
#
# The 10 errors ShellCheck found (SC2068, SC2242, SC2145, SC1128) have all been fixed in code —
# this file only disables warning/note/style classes that the codebase deliberately accepts.
# Do not add error-level codes here; fix those in the code instead.

# The `.cmd`/`.help` files are sourced into `bin/roll`'s shell rather than executed standalone, so
# many "unused" variables and functions are actually consumed by a sibling file after sourcing.
# ShellCheck cannot see across that boundary reliably even with -x, so this fires broadly.
disable=SC2034

# Word splitting/globbing on unquoted expansions is used throughout intentionally — several
# commands build `docker`/`compose` argument lists from unquoted variables that are expected to
# split into multiple words (e.g. compose file lists, flag strings). Auditing every occurrence is
# out of scope for this release; tracked as a future cleanup, not a release-blocker.
disable=SC2086
disable=SC2046

# `local foo="$(cmd)"` masking the command's exit status is a real but low-severity pattern used
# throughout for readability; none of the call sites currently depend on the masked status.
disable=SC2155

# `read` without `-r` is used only where the input is not expected to contain backslashes
# (prompts, simple confirmations); not worth the churn of auditing every call site this release.
disable=SC2162

# `$var` inside arithmetic contexts (`$((...))`) is used repeatedly for readability/consistency
# with the rest of the codebase; functionally harmless.
disable=SC2004

# `printf` format strings built from variables are used in a few places where the variable is a
# known, fixed format (not user-controlled), so there is no injection risk in practice.
disable=SC2059

# `[ -z "$(cmd | grep ...)" ]`-style existence checks read more consistently with this codebase's
# style than `! grep -q`; a stylistic preference, not a defect.
disable=SC2143

# `ls | grep` / `ls` for existence/listing checks is used against paths this tool itself manages
# (not arbitrary user filenames), so the non-alphanumeric-filename edge case does not apply.
disable=SC2010
disable=SC2012

# `cd` without `|| exit` is used only in subshells or where a failed `cd` is immediately followed
# by a command that would itself fail loudly; not worth the churn of auditing every call site.
disable=SC2164

# `${var/pattern}`-quoting nuance inside parameter expansion; the patterns used are static and do
# not contain characters that would be affected.
disable=SC2295

# Splitting command output into an array without `mapfile`/`read -a` is used against
# controlled/simple output (no embedded whitespace edge cases in practice).
disable=SC2207

# Dynamic `source` targets (config files, env fragments resolved at runtime) can't be statically
# followed by ShellCheck; this is expected, not a defect.
disable=SC1090
disable=SC1091

# A literal `{` following a variable in a few brace-expansion-like strings; the surrounding code
# is correct shell, just visually similar to a syntax error.
disable=SC1083

# A handful of `printf`/format-string argument-count mismatches are intentional (extra format
# specifiers are static decoration, not meant to consume an argument).
disable=SC2183

# `$(...)` used to force a subshell / capture-and-discard is intentional in the few spots it
# appears, not an accidental eval.
disable=SC2091

# `sed` used where a parameter expansion could do the same job; a stylistic preference, not a
# defect.
disable=SC2001

# A couple of `expr` uses predate this release's cleanup scope; functionally correct, just
# old-style arithmetic.
disable=SC2003

# `test -eq 0`/`-ne 0` against `$?` right after the command, instead of testing the command
# directly, is used in a couple of places for clarity when there's a comment on the exit code
# itself; harmless.
disable=SC2181

# `grep | wc -l` is used in a couple of places instead of `grep -c`; equivalent output, no
# performance concern at this scale.
disable=SC2126

# Single-quoted strings containing `$var`-looking text are literal examples/help text, not
# expansions the author forgot to escape.
disable=SC2016

# Subshells via `( ... )` are used deliberately in a couple of spots to scope variables/`cd`
# without affecting the caller's shell; the subshell overhead is negligible here.
disable=SC2233
disable=SC2235

# `echo $(cmd)` instead of `cmd` appears once; harmless, output is unchanged.
disable=SC2005

# A `$?` immediately after `echo`/`printf` referring to that command rather than the one before it
# appears once in output the caller does not use.
disable=SC2320

# A variable is used as an array in one context and reassigned as a plain string in another within
# the same script; both usages are correct for the way that variable is actually consumed there.
disable=SC2178

# `commands/magento2/magepack.cmd` ends with unreachable debug output left from earlier work; kept
# out of scope for this release, not treated as a defect worth fixing here.
disable=SC2317

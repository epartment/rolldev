#!/usr/bin/env bash
[[ ! ${ROLL_DIR} ]] && >&2 echo -e "\033[31mThis script is not intended to be run directly!\033[0m" && exit 1

COMPOSE_USAGE=$(docker compose "${ROLL_PARAMS[@]}" "$@" \
  | grep -vE '(--file|--project-name|--project-directory|default: docker-compose.yml|default: directory name)' \
  | sed '1d;2d;s/docker-compose/env/' \
  | sed -E "s/^(Usage|Options|Commands):/$(echo -e "\033[33m\\1:\033[0m")/g"
)

ROLL_USAGE=$(cat <<EOF
${COMPOSE_USAGE}

\033[33mRoll-specific subcommands:\033[0m

  roll env up --wait
    Passed straight through to docker compose native --wait: the command blocks until every
    service with a healthcheck reports healthy (or a start_period timeout is hit), instead of
    returning as soon as containers are started. Use this before running a command that depends
    on a service being ready, for example a database import right after bringing the environment
    up, to avoid racing a service that has not finished starting.

  roll env sh <service> '<command>'
    Run a shell command inside a container with proper shell handling.
    Redirects and pipes work inside the container, not on the host.

    \033[1mWhy use this?\033[0m Without 'sh', redirects land on the host:
      roll env exec php-fpm echo hi > /tmp/probe  # writes to HOST /tmp/probe
      roll env sh php-fpm 'echo hi > /tmp/probe'  # writes to CONTAINER /tmp/probe

    \033[1mExamples:\033[0m
      roll env sh php-fpm 'cat app/etc/env.php | grep MODE'
      roll env sh php-fpm 'echo "test" > /tmp/test.txt'
      roll env sh php-fpm 'ls -la | grep vendor'
EOF
)

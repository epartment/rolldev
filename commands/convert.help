#!/usr/bin/env bash
[[ ! ${ROLL_DIR} ]] && >&2 echo -e "\033[31mThis script is not intended to be run directly!\033[0m" && exit 1
## @description: Convert a Warden project in the current directory to RollDev.
## @category: utility

ROLL_USAGE=$(cat <<EOF
\033[33mUsage:\033[0m
  convert

\033[33mOptions:\033[0m
  -h, --help        Display this help menu

\033[33mDescription:\033[0m
  Run from the root of a Warden project. Renames WARDEN_* variables to ROLL_* in .env, moves
  .env to .env.roll, moves .warden to .roll (warden-env.yml becomes roll-env.yml), validates the
  result, signs a certificate for the project domain, and starts the environment.

  Existing service version pins, including ELASTICSEARCH_VERSION, are left exactly as the
  project had them. If a pin is missing afterwards, run "roll config fix-pins" to write one in.

  Does nothing if .env.roll already exists, or if .env does not reference WARDEN. If the warden
  binary is installed, "warden env down" runs first to release the old containers and ports; on
  a machine without Warden installed this step is skipped.
EOF
)
